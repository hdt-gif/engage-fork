# Template for .envs/.prod -- copy it there and fill in real values.
#
#   cp prod.env.example .envs/.prod
#
# .envs/ is gitignored, so the filled-in copy is never committed. On a server,
# prefer pulling these from SSM Parameter Store at boot over leaving a plaintext
# file on disk.

# --- Django -------------------------------------------------------------------
# Without this the app falls back to settings.local, which means DEBUG=True and
# an ALLOWED_HOSTS list that rejects every hostname except localhost.
DJANGO_SETTINGS_MODULE=calliope_app.settings.prod

# Generate a fresh one; do not reuse the development key.
#   python3 -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=

# Comma-separated. Must include every hostname the app is reached by, including
# the load balancer's health-check target if it uses the instance IP.
DJANGO_ALLOWED_HOSTS=engage.example.org

# The Django admin is served here instead of /admin/. Keep the trailing slash.
DJANGO_ADMIN_URL=admin/

# Leave False until TLS terminates in front of the app. Turning it on without a
# proxy that sets X-Forwarded-Proto produces an infinite redirect loop.
DJANGO_SECURE_SSL_REDIRECT=False

# Secure cookies are only transmitted over HTTPS. On a plain-HTTP instance the
# browser withholds the CSRF cookie and every login fails with a 403. Set both
# False for an HTTP-only test box; leave them True (the default) once TLS is in
# front. Also list the origins forms may be posted from.
DJANGO_SESSION_COOKIE_SECURE=False
DJANGO_CSRF_COOKIE_SECURE=False
DJANGO_CSRF_TRUSTED_ORIGINS=http://your.instance.ip:8000

# HSTS defaults to on with includeSubDomains and preload, which affects every
# subdomain of the parent domain. Set these False unless that is intended.
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=False
DJANGO_SECURE_HSTS_PRELOAD=False

# --- PostgreSQL ---------------------------------------------------------------
# Read by both Django and the postgres container itself. The password is applied
# only when the data directory is first initialised.
POSTGRES_HOST=calliope-postgres
POSTGRES_PORT=5432
POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=

# --- Celery -------------------------------------------------------------------
CELERY_BROKER_URL=redis://redis:6379/0

# False for a redis container on the same host -- it does not speak TLS, and
# leaving this on fails every worker connection. True for ElastiCache with
# transit encryption enabled.
CELERY_BROKER_USE_SSL=False

# user:password. The dashboard refuses to start without it.
FLOWER_BASIC_AUTH=

# --- gunicorn (optional) ------------------------------------------------------
# GUNICORN_WORKERS=3
# GUNICORN_TIMEOUT=120

# --- Mapbox -------------------------------------------------------------------
# Without this every map in the UI renders blank.
MAPBOX_TOKEN=

# --- NREL developer API (optional) --------------------------------------------
# Enables PVWatts and Wind Toolkit timeseries import.
NREL_API_EMAIL=
NREL_API_KEY=

# --- AWS ----------------------------------------------------------------------
# Leave the key and secret blank when running on EC2 with an instance role --
# boto3 picks up instance credentials on its own, which is the safer setup.
AWS_REGION_NAME=us-west-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Optional archive of zipped run outputs.
AWS_S3_BUCKET_NAME=

# SES, for account-activation email. Not needed while accounts are created by
# hand in the Django admin. Note that new SES accounts are sandboxed and can
# only send to verified addresses until you request production access.
AWS_SES_REGION_NAME=
AWS_SES_REGION_ENDPOINT=
AWS_SES_FROM_EMAIL=
